<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Your Password - Rerendet Coffee</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #F8F9FA; margin: 0; padding: 40px 16px; color: #374151; }
    .card { max-width: 580px; margin: 0 auto; background-color: #FFFFFF; border-top: 4px solid #1E3D2F; border-radius: 4px; border-left: 1px solid #E5E7EB; border-right: 1px solid #E5E7EB; border-bottom: 1px solid #E5E7EB; overflow: hidden; padding: 36px 36px 32px; text-align: left; }
    .hero-title { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-size: 32px; font-weight: 400; color: #1F2937; text-align: center; margin: 0 0 12px; }
    .hero-subtitle { font-size: 14.5px; color: #6B7280; text-align: center; line-height: 1.6; margin: 0 auto 24px; max-width: 480px; }
    .btn { display: inline-block; background-color: #1E3D2F; color: #FFFFFF !important; padding: 12px 34px; border-radius: 9999px; text-decoration: none; font-weight: 600; font-size: 14px; }
    .code-box { background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 22px 20px; max-width: 360px; margin: 20px auto; text-align: center; }
    .code { font-family: 'JetBrains Mono', monospace; font-size: 36px; font-weight: 700; letter-spacing: 10px; color: #111827; display: block; padding-left: 10px; }
    .caption { font-size: 11.5px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.8px; margin-top: 8px; display: inline-block; }
    .social-pill { display: inline-block; border: 1px solid #D1D5DB; border-radius: 9999px; padding: 7px 22px; color: #374151 !important; text-decoration: none; font-size: 13.5px; font-weight: 600; }
  </style>
</head>
<body>
  <div class="card">
    <!-- Brand Logo -->
    <div style="text-align: center; margin-bottom: 24px;">
      <a href="https://rerendet-farm.vercel.app" target="_blank" style="text-decoration: none;">
        <img src="https://res.cloudinary.com/dln2pifwf/image/upload/v1779294419/rerendet-coffee/products/pb7indr2rhu7fnhh3jjh.png" alt="Rerendet Coffee" width="140" style="display: block; max-width: 145px; height: auto; margin: 0 auto; border: 0;" />
      </a>
    </div>

    <h1 class="hero-title">Reset your password.</h1>
    <p class="hero-subtitle">Hi {{firstName}}, we received a request to reset your password. You can reset it instantly with the link or code below:</p>

    {{#if resetUrl}}
    <div style="text-align: center; margin: 24px 0 24px 0;">
      <a href="{{resetUrl}}" class="btn">Reset My Password</a>
    </div>
    {{/if}}

    <div class="code-box">
      <span class="code">{{resetCode}}</span>
      <span class="caption">Or enter this 6-digit code</span>
    </div>

    <p style="text-align: center; font-size: 13px; color: #6B7280; margin-top: 18px; line-height: 1.6;">
      This security link and code expire in 15 minutes. If you did not request a password reset, you can safely ignore this message.
    </p>

    <!-- Divider -->
    <div style="border-top: 1px solid #E5E7EB; margin: 34px 0 24px;"></div>

    <p style="text-align: center; color: #6B7280; font-size: 13.5px; margin: 0 0 32px;">
      Questions? Reply to this email and we will help.
    </p>

    <!-- Follow Rerendet Coffee (Instagram Only) -->
    <div style="text-align: center; margin: 0 0 32px;">
      <h3 style="font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-size: 21px; font-weight: 500; color: #111827; margin: 0 0 6px;">
        Follow Rerendet Coffee
      </h3>
      <p style="color: #6B7280; font-size: 13.5px; margin: 0 0 16px;">
        New roasts, brewing tips and offers.
      </p>
      <div style="text-align: center;">
        <a href="https://www.instagram.com/rerendetcoffee" target="_blank" class="social-pill">
          Instagram
        </a>
      </div>
    </div>

    <!-- Policy Links Section -->
    <div style="border-top: 1px solid #E5E7EB; padding-top: 20px; text-align: center; margin: 0 0 24px;">
      <div style="font-size: 12.5px; color: #6B7280; line-height: 2;">
        <a href="https://rerendet-farm.vercel.app/shipping-policy" target="_blank" style="color: #1E3D2F; text-decoration: underline; font-weight: 600; margin: 0 8px;">Shipping &amp; Delivery</a> &bull;
        <a href="https://rerendet-farm.vercel.app/refund-policy" target="_blank" style="color: #1E3D2F; text-decoration: underline; font-weight: 600; margin: 0 8px;">Refund Policy</a> &bull;
        <a href="https://rerendet-farm.vercel.app/terms-conditions" target="_blank" style="color: #1E3D2F; text-decoration: underline; font-weight: 600; margin: 0 8px;">Terms of Service</a> &bull;
        <a href="https://rerendet-farm.vercel.app/privacy-policy" target="_blank" style="color: #1E3D2F; text-decoration: underline; font-weight: 600; margin: 0 8px;">Privacy Policy</a>
      </div>
    </div>

    <!-- Brand Footer (Bomet, Kenya & Phone & Unsubscribe) -->
    <div style="border-top: 1px solid #E5E7EB; padding-top: 22px; text-align: center; font-size: 12.5px; color: #9CA3AF; line-height: 1.8;">
      <p style="margin: 0 0 4px; color: #6B7280;">
        Rerendet Coffee &middot; Bomet, Kenya
      </p>
      <p style="margin: 0 0 8px; color: #6B7280;">
        +254 705 684 984 &middot; <a href="mailto:hello@rerendetcoffee.com" style="color: #6B7280; text-decoration: none;">hello@rerendetcoffee.com</a>
      </p>
      <p style="margin: 0;">
        <a href="https://rerendet-farm.vercel.app/account" style="color: #9CA3AF; text-decoration: underline;">Unsubscribe</a>
      </p>
    </div>
  </div>
</body>
</html>
